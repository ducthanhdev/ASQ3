datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PARENT
  SPECIALIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Relationship {
  PARENT
  GUARDIAN
  TEACHER
  CHILDCARE_PROVIDER
  GRANDPARENT
  FOSTER_PARENT
  OTHER
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  role         Role      @default(PARENT)
  firstName    String?
  middleName   String?
  lastName     String?
  phone        String?
  address      String?   @db.Text
  tokenVersion Int       @default(0)
  refreshToken String?   @db.Text
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  children    Child[]
  assessments Assessment[] @relation("evaluator")
  followUps   FollowUp[]   @relation("assigned_to_user")
  uploads     File[]       @relation("uploader")
}

/**
 * 2. CHILDREN
 */
model Child {
  id                 Int          @id @default(autoincrement())
  parentId           Int?
  firstName          String
  middleName         String?
  lastName           String
  fullName           String       @default("")
  gender             Gender       @default(MALE)
  birthDate          DateTime
  prematureWeeks     Int          @default(0)
  guardianName       String?      @map("guardian_name")
  guardianPhone      String?      @map("guardian_phone")
  note               String?      @db.Text
  registrationNumber String?      @map("registration_number")
  createdAt          DateTime     @default(now())
  parent             User?        @relation(fields: [parentId], references: [id])
  assessments        Assessment[]
}

/**
 * 3. QUESTIONNAIRES
 */
model Questionnaire {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  title     String
  minMonth  Int
  maxMonth  Int
  language  String
  createdAt DateTime @default(now())

  versions     QuestionnaireVersion[]
  ocrTemplates OcrTemplate[]
}

/**
 * 4. QUESTIONNAIRE VERSIONS
 */
model QuestionnaireVersion {
  id              Int      @id @default(autoincrement())
  questionnaireId Int
  version         String
  structureJson   Json
  createdAt       DateTime @default(now())

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id])
  assessments   Assessment[]
  ocrResults    OcrResult[]
}

/**
 * 5. ASSESSMENTS
 */
model Assessment {
  id                     Int      @id @default(autoincrement())
  childId                Int
  questionnaireVersionId Int
  evaluatorId            Int?
  assessmentDate         DateTime
  completionDate         DateTime @default(now())
  answersJson            Json?
  scoresJson             Json?
  summaryResultJson      Json?
  finalConclusion        String   @default("PENDING_REVIEW")
  method                 String   @default("ONLINE")
  scanFileId             Int?     @unique

  evaluatorFirstName        String?
  evaluatorMiddleName       String?
  evaluatorLastName         String?
  relationship              Relationship?
  evaluatorAddress          String?       @db.Text
  evaluatorHomePhone        String?
  evaluatorOtherPhone       String?
  evaluatorEmail            String?
  helperName                String?
  programRegistrationNumber String?
  programName               String?

  createdAt DateTime @default(now())

  child                Child                @relation(fields: [childId], references: [id])
  questionnaireVersion QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  evaluator            User?                @relation("evaluator", fields: [evaluatorId], references: [id])

  scanFile File? @relation("AssessmentScanFile", fields: [scanFileId], references: [id])

  followUps FollowUp[]
}

/**
 * 6. FILES
 */
model File {
  id           Int      @id @default(autoincrement())
  uploaderId   Int?
  originalName String
  storagePath  String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime @default(now())

  uploader User? @relation("uploader", fields: [uploaderId], references: [id])

  ocrResults OcrResult[]

  // ---- FIXED: back relation to Assessment ----
  assessment Assessment? @relation("AssessmentScanFile")
}

/**
 * 7. OCR_RESULTS
 */
model OcrResult {
  id                     Int      @id @default(autoincrement())
  fileId                 Int
  questionnaireVersionId Int?
  rawText                String?
  parsedAnswersJson      Json?
  confidence             Float?
  bboxJson               Json?
  createdAt              DateTime @default(now())

  file                 File                  @relation(fields: [fileId], references: [id])
  questionnaireVersion QuestionnaireVersion? @relation(fields: [questionnaireVersionId], references: [id])
}

/**
 * 8. OCR_TEMPLATES
 */
model OcrTemplate {
  id              Int      @id @default(autoincrement())
  questionnaireId Int
  pageWidth       Int
  pageHeight      Int
  boxesJson       Json
  createdAt       DateTime @default(now())

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id])
}

/**
 * 9. FOLLOW_UPS
 */
model FollowUp {
  id           Int       @id @default(autoincrement())
  assessmentId Int
  actionType   String
  notes        String?
  dueDate      DateTime?
  assignedTo   Int?
  status       String    @default("OPEN")

  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assignedUser User?      @relation("assigned_to_user", fields: [assignedTo], references: [id])
}
