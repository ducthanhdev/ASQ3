<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Báo cáo ASQ-3</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 28px;
      font-size: 14px;
      color: #111;
    }
    h1, h2, h3 { margin: 0; padding: 0; }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
    }
    .title {
      text-align: center;
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .subtitle {
      text-align: center;
      font-size: 15px;
      margin-bottom: 24px;
    }
    .section-title {
      font-size: 16px;
      font-weight: bold;
      margin-top: 26px;
      margin-bottom: 6px;
      text-transform: uppercase;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    th, td {
      border: 1px solid #ccc;
      padding: 8px;
      text-align: center;
      font-size: 13px;
    }
    .normal { background: #eaffea; color: #1d7a25; font-weight: bold; }
    .monitor { background: #fff8d9; color: #8a6d00; font-weight: bold; }
    .refer { background: #ffe6e6; color: #b30000; font-weight: bold; }
    .advice-list li {
      margin-bottom: 4px;
    }
    footer {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      text-align: center;
      font-size: 11px;
      padding-bottom: 10px;
    }
  </style>
</head>
<body>
  <div class="header">
    <div style="flex: 1;">
      {{#if logo_url}}
      <img src="{{logo_url}}" alt="logo" style="width: 130px; height: auto;" />
      {{else}}
      <div style="width: 130px; height: 60px; background: #f0f0f0; border: 1px solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #999;">
        Logo
      </div>
      {{/if}}
    </div>
    <div style="text-align: right; flex: 1;">
      <div><strong>{{org_name}}</strong></div>
      {{#if org_address}}
      <div style="font-size: 12px;">{{org_address}}</div>
      {{/if}}
      {{#if org_phone}}
      <div style="font-size: 12px;">Hotline: {{org_phone}}</div>
      {{/if}}
    </div>
  </div>

  <div class="title">BÁO CÁO KẾT QUẢ ĐÁNH GIÁ PHÁT TRIỂN ASQ-3</div>
  <div class="subtitle">Mốc tuổi: <strong>{{age_month}} tháng</strong></div>

  <div class="section-title">1. Thông tin trẻ</div>
  <table>
    <tr>
      <td style="text-align:left"><strong>Họ tên:</strong> {{child_name}}</td>
      <td style="text-align:left"><strong>Giới tính:</strong> {{gender}}</td>
    </tr>
    <tr>
      <td style="text-align:left"><strong>Ngày sinh:</strong> {{birth_date}}</td>
      <td style="text-align:left"><strong>Tuổi đánh giá:</strong> {{age_month}} tháng</td>
    </tr>
    <tr>
      <td style="text-align:left"><strong>Phụ huynh:</strong> {{parent_name}}</td>
      <td style="text-align:left"><strong>SĐT:</strong> {{parent_phone}}</td>
    </tr>
  </table>

  <div class="section-title">2. Người thực hiện</div>
  <table>
    <tr>
      <td style="text-align:left">
        <strong>Người điền form:</strong> 
        {{#if evaluator_name}}
          {{evaluator_name}}{{#if relationship_text}} ({{relationship_text}}){{/if}}
        {{else}}
          {{fallback_evaluator_name}}
        {{/if}}
      </td>
      <td style="text-align:left"><strong>Ngày đánh giá:</strong> {{assessment_date}}</td>
    </tr>
  </table>

  <div class="section-title">3. Kết quả đánh giá theo 5 lĩnh vực</div>
  <table>
    <thead>
      <tr>
        <th>Lĩnh vực</th>
        <th>Điểm</th>
        <th>Ngưỡng (Cutoff)</th>
        <th>Kết luận</th>
      </tr>
    </thead>
    <tbody>
      {{#each domain_results}}
      <tr class="{{this.result_class}}">
        <td>{{this.title}}</td>
        <td>{{this.total}}</td>
        <td>{{this.cutoff}}</td>
        <td>{{this.result_text}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="section-title">4. HOẠT ĐỘNG THEO DÕI TIẾP THEO: đánh dấu các mục phù hợp</div>
  <div style="padding: 8px 2px; font-size: 13px; line-height: 1.8;">
    <div style="display: flex; align-items: flex-start; margin-bottom: 8px;">
      <span style="width: 20px; height: 16px; border: 1px solid #333; display: inline-block; margin-right: 8px; margin-top: 2px;"></span>
      <span>Cung cấp các hoạt động và kiểm tra lại sau _____ tháng.</span>
    </div>
    <div style="display: flex; align-items: flex-start; margin-bottom: 8px;">
      <span style="width: 20px; height: 16px; border: 1px solid #333; display: inline-block; margin-right: 8px; margin-top: 2px;"></span>
      <span>Chia sẻ kết quả với nhân viên y tế cấp cơ sở.</span>
    </div>
    <div style="display: flex; align-items: flex-start; margin-bottom: 8px;">
      <span style="width: 20px; height: 16px; border: 1px solid #333; display: inline-block; margin-right: 8px; margin-top: 2px;"></span>
      <span>Xem mục (khoanh tròn mục phù hợp) sàng lọc thính giác, thị giác, và/hoặc cử chỉ.</span>
    </div>
    <div style="display: flex; align-items: flex-start; margin-bottom: 8px;">
      <span style="width: 20px; height: 16px; border: 1px solid #333; display: inline-block; margin-right: 8px; margin-top: 2px;"></span>
      <span>Đưa đến nhân viên y tế cấp cơ sở hoặc các trạm y tế địa phương (ghi rõ lý do): _______________________</span>
    </div>
    <div style="display: flex; align-items: flex-start; margin-bottom: 8px;">
      <span style="width: 20px; height: 16px; border: 1px solid #333; display: inline-block; margin-right: 8px; margin-top: 2px;"></span>
      <span>Đưa trẻ đi can thiệp sớm/giáo dục đặc biệt cho trẻ mầm non.</span>
    </div>
    <div style="display: flex; align-items: flex-start; margin-bottom: 8px;">
      <span style="width: 20px; height: 16px; border: 1px solid #333; display: inline-block; margin-right: 8px; margin-top: 2px;"></span>
      <span>Không cần hành động nào thêm tại thời điểm này.</span>
    </div>
    <div style="display: flex; align-items: flex-start; margin-bottom: 8px;">
      <span style="width: 20px; height: 16px; border: 1px solid #333; display: inline-block; margin-right: 8px; margin-top: 2px;"></span>
      <span>Khác (ghi rõ): ______________________________________________</span>
    </div>
  </div>

  <div class="section-title">5. TÙY CHỌN: chuyển các mục đáp ứng</div>
  <div style="font-size: 12px; margin-bottom: 8px;">(Y=CÓ, S=ĐÔI KHI, N=CHƯA, X=không trả lời)</div>
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr>
        <th style="border: 1px solid #333; padding: 6px; text-align: left;"></th>
        <th style="border: 1px solid #333; padding: 6px; width: 40px;">1</th>
        <th style="border: 1px solid #333; padding: 6px; width: 40px;">2</th>
        <th style="border: 1px solid #333; padding: 6px; width: 40px;">3</th>
        <th style="border: 1px solid #333; padding: 6px; width: 40px;">4</th>
        <th style="border: 1px solid #333; padding: 6px; width: 40px;">5</th>
        <th style="border: 1px solid #333; padding: 6px; width: 40px;">6</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="border: 1px solid #333; padding: 6px; text-align: left;">Giao tiếp</td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
      </tr>
      <tr>
        <td style="border: 1px solid #333; padding: 6px; text-align: left;">Vận động toàn thân</td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
      </tr>
      <tr>
        <td style="border: 1px solid #333; padding: 6px; text-align: left;">Vận động tinh</td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
      </tr>
      <tr>
        <td style="border: 1px solid #333; padding: 6px; text-align: left;">Giải quyết vấn đề</td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
      </tr>
      <tr>
        <td style="border: 1px solid #333; padding: 6px; text-align: left;">Cá nhân – xã hội</td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
        <td style="border: 1px solid #333; padding: 6px;"></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">6. Kết luận tổng quát</div>
  <div style="padding: 8px 2px; font-size:14px;">
    {{final_conclusion_text}}
  </div>

  {{#if advices}}
  <div class="section-title">7. Gợi ý hỗ trợ phát triển</div>
  <ul class="advice-list">
    {{#each advices}}
      <li>{{this}}</li>
    {{/each}}
  </ul>
  {{/if}}

  {{#if has_signer}}
  <div style="margin-top: 50px; text-align: center;">
    <div style="font-weight: bold; font-size: 14px; margin-bottom: 30px;">CHỮ KÝ XÁC NHẬN CỦA CHUYÊN VIÊN</div>
    {{#if has_signature}}
    <div style="margin-bottom: 50px;">
      <img src="{{signature_url}}" style="max-width: 180px; max-height: 80px; margin-bottom: 5px;" />
    </div>
    {{else}}
    <div style="margin-bottom: 50px;">
      <div style="width: 200px; height: 1px; border-bottom: 1.5px solid #000; margin: 0 auto 5px;"></div>
    </div>
    {{/if}}
    <div style="font-weight: bold; font-size: 14px; margin-bottom: 3px;">{{signer_name}}</div>
    {{#if signer_role}}
    <div style="font-size: 13px; margin-bottom: 3px;">{{signer_role}}</div>
    {{/if}}
    <div style="font-size: 13px;">{{signed_at}}</div>
  </div>
  {{/if}}

  <footer>
    Báo cáo ASQ-3 • Mã bài đánh giá: {{assessment_id}}
  </footer>
</body>
</html>

